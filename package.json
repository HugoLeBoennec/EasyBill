{
  "name": "easybill",
  "productName": "EasyBill",
  "version": "1.0.0",
  "description": "Desktop invoicing and quoting app for French businesses, with e-invoicing support (Factur-X, UBL, Chorus Pro).",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "invoicing",
    "e-invoicing",
    "factur-x",
    "ubl",
    "electron"
